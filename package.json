{
  "name": "pc-recap",
  "desktopName": "pc-recap.desktop",
  "version": "1.2.0",
  "private": true,
  "author": "PC Recap",
  "license": "GPL-3.0-only",
  "homepage": "https://pcrecap.online/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAgencyMGE/pc-recap.git"
  },
  "bugs": {
    "url": "https://github.com/TheAgencyMGE/pc-recap/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "An open-source visual app usage tracker and computer history time capsule for Windows, macOS, and Linux.",
  "keywords": [
    "activity-tracker",
    "app-usage",
    "data-visualization",
    "desktop-app",
    "digital-wellbeing",
    "electron",
    "lifelogging",
    "linux",
    "macos",
    "personal-analytics",
    "sqlite",
    "time-tracker",
    "windows"
  ],
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"esbuild ./src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload.cjs --watch\" \"wait-on tcp:127.0.0.1:5173 dist/main/main.js dist/main/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:run": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "smoke:activity": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-activity.mjs",
    "smoke:visual": "node scripts/visual-smoke.mjs",
    "smoke:visual:test": "node --test scripts/visual-smoke.test.mjs",
    "website:validate": "node scripts/validate-website.mjs",
    "promotion:test": "node --test scripts/prepare-promotion.test.mjs scripts/submit-indexnow.test.mjs scripts/website-motion.test.mjs",
    "promotion:prepare": "node scripts/prepare-promotion.mjs && npm run website:validate",
    "seo:submit": "node scripts/submit-indexnow.mjs",
    "release:inspect": "node scripts/verify-installer.mjs",
    "release:verify": "node scripts/verify-installer.mjs",
    "release:prepare": "node scripts/verify-installer.mjs --write-checksum",
    "release:verify-all": "node scripts/release-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json && esbuild ./src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload.cjs",
    "build": "rimraf dist && npm run build:main && vite build",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "package:check": "npm run build && electron-builder --dir --publish never",
    "benchmark:performance": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/benchmark-performance.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "better-sqlite3": "13.0.3",
    "framer-motion": "11.15.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "25.0.1",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.pcrecap.app",
    "productName": "PC Recap",
    "electronLanguages": ["en-US"],
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "PC-Recap-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "artifactName": "PC-Recap-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "PC Recap uses System Events only when you enable optional window-title capture. Activity and titles stay on this Mac."
      }
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "PC-Recap-${version}-linux-${arch}.${ext}",
      "category": "Utility",
      "executableName": "pc-recap",
      "syncDesktopName": true,
      "maintainer": "PC Recap <TheAgencyMGE@users.noreply.github.com>",
      "vendor": "PC Recap",
      "synopsis": "A visual time capsule for your computer life",
      "description": "PC Recap turns locally recorded application activity into visual daily, weekly, monthly, and yearly recaps."
    },
    "appImage": {
      "artifactName": "PC-Recap-${version}-linux-x64.AppImage"
    },
    "deb": {
      "artifactName": "PC-Recap-${version}-linux-x64.deb"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
