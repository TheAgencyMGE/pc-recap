{
  "name": "pc-wrapped",
  "version": "1.0.0",
  "private": true,
  "author": "PC Wrapped",
  "license": "UNLICENSED",
  "homepage": "https://github.com/TheAgencyMGE/pc-wrapped#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAgencyMGE/pc-wrapped.git"
  },
  "bugs": {
    "url": "https://github.com/TheAgencyMGE/pc-wrapped/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "A private, local-first time capsule for your PC life.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload.cjs --watch\" \"wait-on tcp:127.0.0.1:5173 dist/main/main.js dist/main/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:run": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "smoke:activity": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-activity.mjs",
    "website:validate": "node scripts/validate-website.mjs",
    "release:inspect": "node scripts/verify-installer.mjs",
    "release:verify": "node scripts/verify-installer.mjs",
    "release:prepare": "node scripts/verify-installer.mjs --write-checksum",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload.cjs",
    "build": "rimraf dist && npm run build:main && vite build",
    "package": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "better-sqlite3": "13.0.3",
    "framer-motion": "11.15.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "25.0.1",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.pcwrapped.app",
    "productName": "PC Wrapped",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.svg",
      "artifactName": "PC-Wrapped-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
